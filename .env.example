# startup-next corriendo en local (npm run dev, PORT=8000 por defecto).
STARTUP_NEXT_URL=http://localhost:8000

# Mismo valor que API_KEY_APP en el .env.local de startup-next, invocador "app".
API_KEY_APP=

# Mismo valor que API_KEY_ADMIN en el .env.local de startup-next -- solo la
# usan las rutas de administración (/api/admin/*), nunca el flujo normal.
API_KEY_ADMIN=

# Login liviano por magic link (sección 9 del diseño) -- sin base de datos
# propia acá, link y sesión son JWT autoverificables (jose). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Email que siempre puede pedir el magic link, sin consultar allowed_emails
# (bootstrap: si la tabla está vacía, nadie podría loguearse para agregar el
# primer email). También es quien ve la sección "Administrar accesos" en /.
SUPERADMIN_EMAIL=

# Resend (https://resend.com) -- envío del magic link.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
